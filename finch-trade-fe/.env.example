# Set this to true for the standalone Vercel demo.
VITE_DEMO_MODE=false

# Set this to true only when testing repeated trades with the same user.
# It bypasses the mock demo's 24-hour recently-traded restriction.
VITE_DEMO_IGNORE_RECENT_TRADE_LIMIT=false

# Only needed when VITE_DEMO_MODE is false.
VITE_API_BASE_URL=http://localhost:5000